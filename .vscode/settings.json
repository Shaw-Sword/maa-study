{
    "json.schemas": [
        {
            "fileMatch": [
                // "/assets/resource/**/*.json",
                // "/install/resource/**/*.json",
                // "/assets/resource/**/*.jsonc",
                // "/install/resource/**/*.jsonc"
                "/assets/resource/pipeline/*.json",
                "/install/resource/pipeline/*.json",
                "/assets/resource/pipeline/*.jsonc",
                "/install/resource/pipeline/*.jsonc"
            ],
            "url": "/deps/tools/pipeline.schema.json"
        },
        {
            "fileMatch": [
                "/assets/interface.json",
                "/install/interface.json",
                "interface.json"
            ],
            "url": "/deps/tools/interface.schema.json"
        },
        {
            "fileMatch": [
                "/install/config/maa_pi_config.json"
            ],
            "url": "/deps/tools/interface_config.schema.json"
        },
        {
            "fileMatch": [
                "/tasks/*.json",
                "/assets/resource/tasks/*.json",
                "/install/resource/tasks/*.json",
                "/assets/resource/preset/*.json",
                "/install/resource/preset/*.json"
            ],
            "url": "/deps/tools/interface_import.schema.json"
        },
    ],
    "files.associations": {
        "**/assets/**/*.json": "jsonc",
        "interface.json": "jsonc",
    },
    "[json][jsonc]": {
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.indentSize": "tabSize"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "[markdown]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    }
}